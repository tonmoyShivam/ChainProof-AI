# VerityAI environment template — copy to .env and fill in local values.
# Never commit real secrets or private keys.

# Application
APP_NAME=VerityAI
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database — SQLite for Milestone 4 local/dev; Postgres for Milestone 5+
DATABASE_URL=sqlite+pysqlite:///./verityai.db
# DATABASE_URL=postgresql+psycopg2://verityai:verityai@localhost:5432/verityai
POSTGRES_USER=verityai
POSTGRES_PASSWORD=verityai
POSTGRES_DB=verityai

# Blockchain / Hardhat local node
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
# Hardhat account #0 (PUBLIC test key only — never a real wallet)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_TX_TIMEOUT_SECONDS=60

# Storage / uploads
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.pt,.pth,.onnx,.h5,.hdf5,.pb,.tflite,.pkl,.joblib,.safetensors,.bin,.gguf,.json,.txt

# Frontend (also see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8000
